<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms needed for NotifyIcon (system tray) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Prevent WinForms implicit usings from polluting WPF code files -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>SpotifyIsland</AssemblyName>
    <RootNamespace>SpotifyIsland</RootNamespace>
    <Version>1.2.0</Version>
    <Description>Dynamic Island companion widget for Spotify on Windows</Description>
    <Copyright>MIT License</Copyright>
    <!-- Needed so app.ico is copied alongside the EXE for tray icon -->
    <AllowedReferenceRelatedFileExtensions>.ico</AllowedReferenceRelatedFileExtensions>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- These service files use APIs not available in the WPF XAML temp project.
       Marking them as Compile with no contribution to the BAML intermediate step. -->
  <ItemGroup>
    <Compile Update="Services\ProcessWatcherService.cs">
      <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
    </Compile>
  </ItemGroup>

  <!-- Copy app.ico to output directory so tray icon loads at runtime -->
  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
