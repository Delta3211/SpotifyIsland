<Window x:Class="SpotifyIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SpotifyIsland.Controls"
        mc:Ignorable="d"
        Title="Spotify Island" 
        Height="300" Width="640"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseDown="OnWindowMouseDown"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">

    <Window.Resources>
        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Action Button (Extra Rounded) -->
        <Style x:Key="RoundControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="19" Width="38" Height="38">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Sleek Slider Style -->
        <Style x:Key="SleekSliderThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="thumbEllipse" Fill="#FFFFFF" Width="13" Height="13">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbEllipse" Property="Width" Value="15"/>
                                <Setter TargetName="thumbEllipse" Property="Height" Value="15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SleekSlider" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track -->
                            <Border Height="5" CornerRadius="2.5" Background="#28FFFFFF" />
                            <!-- Active Fill -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="TrackFill" Height="5" CornerRadius="2.5" Background="{Binding ElementName=PlayPauseButtonBorder, Path=Background}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SleekSliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Grid for Dynamic Island & Edge Peek Tabs -->
    <Grid x:Name="MainRootGrid" Margin="0,10,0,0" VerticalAlignment="Top">
        <!-- Left Edge Peek Arrow Tab (Shown when docked to left screen edge) -->
        <Border x:Name="LeftPeekTab"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="32" Height="76"
                CornerRadius="0, 16, 16, 0"
                Cursor="Hand"
                Visibility="Collapsed"
                ToolTip="Spotify Island (Hover or Click to open)"
                MouseEnter="OnPeekTabMouseEnter"
                MouseDown="OnPeekTabMouseDown">
            <Border.Effect>
                <DropShadowEffect x:Name="LeftTabGlow" BlurRadius="20" ShadowDepth="2" Direction="0" Color="#1ED760" Opacity="0.7"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0141418" Offset="0.0"/>
                    <GradientStop Color="#F8101014" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#40FFFFFF" Offset="0.0"/>
                    <GradientStop x:Name="LeftTabBorderAccent" Color="#901ED760" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Left="0" Top="1.5" Right="1.5" Bottom="1.5"/>
            </Border.BorderThickness>

            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="LeftTabDot" Width="6" Height="6" Fill="#1ED760" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <Path x:Name="LeftTabArrow"
                          Data="M 0 0 L 6 6 L 0 12"
                          Stroke="#FFFFFF"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Edge Peek Arrow Tab (Shown when docked to right screen edge) -->
        <Border x:Name="RightPeekTab"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="32" Height="76"
                CornerRadius="16, 0, 0, 16"
                Cursor="Hand"
                Visibility="Collapsed"
                ToolTip="Spotify Island (Hover or Click to open)"
                MouseEnter="OnPeekTabMouseEnter"
                MouseDown="OnPeekTabMouseDown">
            <Border.Effect>
                <DropShadowEffect x:Name="RightTabGlow" BlurRadius="20" ShadowDepth="2" Direction="180" Color="#1ED760" Opacity="0.7"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F8101014" Offset="0.0"/>
                    <GradientStop Color="#F0141418" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="RightTabBorderAccent" Color="#901ED760" Offset="0.0"/>
                    <GradientStop Color="#40FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Left="1.5" Top="1.5" Right="0" Bottom="1.5"/>
            </Border.BorderThickness>

            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="RightTabDot" Width="6" Height="6" Fill="#1ED760" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <Path x:Name="RightTabArrow"
                          Data="M 6 0 L 0 6 L 6 12"
                          Stroke="#FFFFFF"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Island Main Capsule -->
        <Border x:Name="IslandContainer"
                HorizontalAlignment="Center"
                Width="320" Height="56"
                CornerRadius="28"
                Cursor="Hand"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="IslandTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            
            <!-- Dynamic Outer Shadow & Ambient Glow -->
            <Border.Effect>
                <DropShadowEffect x:Name="IslandDropShadow" 
                                  BlurRadius="28" 
                                  ShadowDepth="4" 
                                  Direction="270"
                                  Color="#1ED760" 
                                  Opacity="0.5"/>
            </Border.Effect>

            <!-- Background Mesh Glass (Deep Solid Obsidian with Ambient Tint) -->
            <Border.Background>
                <RadialGradientBrush x:Name="IslandBackdropBrush" Center="0.15,0.4" GradientOrigin="0.15,0.4" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop x:Name="GlowColorStop" Color="#401ED760" Offset="0.0"/>
                    <GradientStop x:Name="MidColorStop" Color="#F5141418" Offset="0.5"/>
                    <GradientStop x:Name="DarkColorStop" Color="#FC101014" Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>

            <!-- 1.5px Ultra-Smooth Border Stroke -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="BorderTopStop" Color="#60FFFFFF" Offset="0.0"/>
                    <GradientStop x:Name="BorderMidStop" Color="#401ED760" Offset="0.4"/>
                    <GradientStop Color="#25FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Left="1.5" Top="1.5" Right="1.5" Bottom="1.5"/>
            </Border.BorderThickness>

            <Grid>
                <!-- ============================================== -->
                <!-- COMPACT PILL VIEW (Default)                    -->
                <!-- ============================================== -->
                <Grid x:Name="PillView" Height="56" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Bigger Spinning Vinyl Disc (38x38) -->
                    <Grid Grid.Column="0" Margin="9,0,8,0" Width="38" Height="38" VerticalAlignment="Center">
                        <!-- Vinyl Record Rim -->
                        <Ellipse Fill="#18181A" Stroke="#35FFFFFF" StrokeThickness="1.2"/>
                        <Ellipse Width="24" Height="24" Stroke="#25FFFFFF" StrokeThickness="1"/>
                        
                        <!-- Thumbnail Image (Rotates when playing - Clipped to Circle) -->
                        <Image x:Name="MiniCoverImage" Width="38" Height="38" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                            <Image.Clip>
                                <EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/>
                            </Image.Clip>
                            <Image.RenderTransform>
                                <RotateTransform x:Name="MiniVinylRotation" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Center Hole Spindle -->
                        <Ellipse Width="8" Height="8" Fill="#101014" Stroke="#60FFFFFF" StrokeThickness="1.2"/>
                    </Grid>

                    <!-- Center: Track Title & Artist -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock x:Name="PillTitleText" 
                                   Text="Blinding Lights" 
                                   Foreground="#FFFFFF" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PillArtistText" 
                                   Text="The Weeknd" 
                                   Foreground="#9E9EA5" 
                                   FontSize="10.5" 
                                   TextTrimming="CharacterEllipsis" 
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Right: Mini Visualizer Indicator -->
                    <Grid Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                        <controls:VisualizerControl x:Name="PillVisualizer" Width="32" Height="18" />
                    </Grid>
                </Grid>

                <!-- ============================================== -->
                <!-- DYNAMIC VOLUME HUD OVERLAY                     -->
                <!-- ============================================== -->
                <Grid x:Name="VolumeHudView" Visibility="Collapsed" Opacity="0" Height="56" VerticalAlignment="Center" Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speaker Icon -->
                    <Path x:Name="VolumeSpeakerIcon" Grid.Column="0" Fill="#1ED760" VerticalAlignment="Center" Margin="2,0,14,0"
                          Data="M2,6 L5,6 L9,2 L9,14 L5,10 L2,10 Z M11,5 C12.5,6.5 12.5,9.5 11,11" Stretch="Uniform" Width="16" Height="16"/>

                    <!-- Fluid Volume Progress Track -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0" Height="10">
                        <Border Height="8" CornerRadius="4" Background="#25FFFFFF"/>
                        <Border x:Name="VolumeFillBar" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="120" Background="#1ED760">
                            <Border.Effect>
                                <DropShadowEffect x:Name="VolumeFillGlow" BlurRadius="10" ShadowDepth="0" Color="#1ED760" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <!-- Volume Percentage Text -->
                    <TextBlock x:Name="VolumePercentText" Grid.Column="2" Text="68%" 
                               Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                </Grid>

                <!-- Apple Glass Top Specular Sheen (Physical Glass Reflection) -->
                <Border x:Name="GlassSheenBorder" CornerRadius="28" IsHitTestVisible="False" VerticalAlignment="Top" Height="30">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#30FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============================================== -->
                <!-- EXPANDED ISLAND VIEW (Generous & Rounded)       -->
                <!-- ============================================== -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Margin="20,13,20,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header bar -->
                        <RowDefinition Height="*"/>    <!-- Center content -->
                        <RowDefinition Height="Auto"/> <!-- Seek slider & controls -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <!-- Spotify Live & Quality Badges -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#1ED760" Margin="0,0,7,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#1ED760" Opacity="0.85"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="AppStatusText" 
                                       Text="SPOTIFY" 
                                       Foreground="#B5B5BC" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center"/>

                            <!-- Lossless Hi-Fi Audio Badge -->
                            <Border x:Name="HiFiBadge" 
                                    Background="#1AFFFFFF" 
                                    BorderBrush="#25FFFFFF" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Fill="#FFD700" Data="M1,4 L3,1 L5,7 L7,2 L9,5" Stroke="#FFD700" StrokeThickness="1.2" Width="9" Height="8" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Text="LOSSLESS" Foreground="#E0E0E0" FontSize="8.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DemoBadge" 
                                    Background="#30FF8800" 
                                    CornerRadius="6" 
                                    Padding="7,2" 
                                    Margin="8,0,0,0"
                                    Visibility="Visible">
                                <TextBlock Text="PREVIEW" Foreground="#FFA500" FontSize="9.5" FontWeight="Bold"/>
                            </Border>

                            <Border x:Name="NowPlayingBadge" 
                                    Background="#251ED760" 
                                    BorderBrush="#601ED760" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="7,2" 
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Text="NOW PLAYING" Foreground="#1ED760" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Top Action Icons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Toggle Demo Mode -->
                            <Button x:Name="DemoButton" Style="{StaticResource IconButtonStyle}" 
                                    Padding="7,3" Margin="0,0,5,0" ToolTip="Cycle Demo Tracks" Click="OnDemoClick">
                                <TextBlock Text="Demo ↺" FontSize="11" Foreground="#BBBBBB"/>
                            </Button>

                            <!-- Focus Spotify Window -->
                            <Button Style="{StaticResource IconButtonStyle}" Padding="6" Margin="0,0,3,0" 
                                    ToolTip="Bring Spotify to Front" Click="OnFocusSpotifyClick">
                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                      Data="M2,2 H10 V4 H4 V10 H2 Z M6,6 H14 V14 H6 Z" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <!-- Auto-Bloom on Track Change Toggle -->
                            <Button x:Name="BloomButton" Style="{StaticResource IconButtonStyle}" Padding="6" Margin="0,0,3,0" 
                                    ToolTip="Auto-Bloom: Expand on track change (Active)" Click="OnBloomToggleClick">
                                <Path x:Name="BloomIconPath" Fill="#1ED760" 
                                      Data="M7,1 L8.5,5 L12.5,5 L9.5,7.5 L10.5,11.5 L7,9 L3.5,11.5 L4.5,7.5 L1.5,5 L5.5,5 Z" 
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>

                            <!-- Pin Island Open -->
                            <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}" Padding="6" Margin="0,0,3,0" 
                                    ToolTip="Pin (Stay Expanded)" Click="OnPinClick">
                                <Path x:Name="PinIconPath" Fill="#888888" 
                                      Data="M5,1 L9,1 L9,3 L8,4 L8,8 L10,10 L7,10 L7,14 L6,14 L6,10 L3,10 L5,8 L5,4 L4,3 L4,1 Z" 
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <!-- Snap to Top Center -->
                            <Button Style="{StaticResource IconButtonStyle}" Padding="6" Margin="0,0,3,0" 
                                    ToolTip="Snap to Top-Center" Click="OnSnapTopClick">
                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                      Data="M7,1 L1,7 L4,7 L4,13 L10,13 L10,7 L13,7 Z" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>

                            <!-- Collapse Button -->
                            <Button Style="{StaticResource IconButtonStyle}" Padding="6" 
                                    ToolTip="Collapse to Pill" Click="OnCollapseClick">
                                <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                      Data="M1,6 L6,1 L11,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                      StrokeThickness="1.6" Width="12" Height="8" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Center Content: Large Cover + Info + Visualizer -->
                    <Grid Grid.Row="1" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Large Rounded Album Cover Artwork (88x88, radius 22) -->
                        <Grid Grid.Column="0" Width="88" Height="88" Margin="0,0,18,0">
                            <!-- Soft ambient aura behind artwork -->
                            <Border CornerRadius="22" Background="#15FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="AlbumCoverGlow" BlurRadius="26" ShadowDepth="3" Color="#1ED760" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>

                            <Image x:Name="LargeCoverImage" Width="88" Height="88" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,88,88" RadiusX="22" RadiusY="22"/>
                                </Image.Clip>
                            </Image>

                            <!-- Subtle inner border sheen on cover -->
                            <Border CornerRadius="22" BorderBrush="#25FFFFFF" BorderThickness="1.2" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Track Info & Visualizer Column -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Track Title & Interactive Favorite Heart -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LargeTitleText" 
                                           Text="Blinding Lights" 
                                           Foreground="#FFFFFF" 
                                           FontSize="16.5" 
                                           FontWeight="Bold" 
                                           MaxWidth="320"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <!-- Like / Favorite Toggle Button -->
                                <Button x:Name="FavoriteButton" 
                                        Style="{StaticResource IconButtonStyle}" 
                                        Margin="10,0,0,0" 
                                        Padding="4"
                                        ToolTip="Save to Your Library" 
                                        Click="OnFavoriteClick"
                                        VerticalAlignment="Center">
                                    <Path x:Name="FavoriteHeartPath" 
                                          Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" 
                                          Fill="Transparent" 
                                          Stroke="#9E9EA8" 
                                          StrokeThickness="1.8" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="FavoriteHeartTransform" ScaleX="1.0" ScaleY="1.0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                            </StackPanel>

                            <!-- Artist & Album -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,5">
                                <TextBlock x:Name="LargeArtistText" 
                                           Text="The Weeknd" 
                                           Foreground="#B8B8C0" 
                                           FontSize="12" 
                                           FontWeight="Medium" 
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text=" • " Foreground="#666666" FontSize="12"/>
                                <TextBlock x:Name="LargeAlbumText" 
                                           Text="After Hours" 
                                           Foreground="#8A8A92" 
                                           FontSize="11.5" 
                                           MaxWidth="160"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Audio Device & Stream Quality Badges -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#16FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="7" Padding="6,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Fill="#1ED760" Data="M3,9 A9,9 0 0,1 21,9 V16 A3,3 0 0,1 18,19 H17 V13 H19 V9 A7,7 0 0,0 5,9 V13 H7 V19 H6 A3,3 0 0,1 3,16 Z" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="AudioDeviceText" Text="HEADPHONES" Foreground="#D5D5DC" FontSize="9" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#12FFFFFF" CornerRadius="7" Padding="6,2">
                                    <TextBlock Text="320 KBPS MASTER" Foreground="#888892" FontSize="8.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- Large Audio Visualizer (18 bars) -->
                            <Grid Grid.Row="3" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="180">
                                <controls:VisualizerControl x:Name="LargeVisualizer" Height="20" Width="180"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 3. Bottom Area: Seekbar + Transport Controls -->
                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Timeline & Timestamps -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="0:24" 
                                       Foreground="#A0A0A8" FontSize="11" FontWeight="SemiBold" 
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <Slider x:Name="SeekSlider" Grid.Column="1" 
                                    Style="{StaticResource SleekSlider}" 
                                    VerticalAlignment="Center"
                                    PreviewMouseDown="OnSeekSliderMouseDown"
                                    PreviewMouseUp="OnSeekSliderMouseUp"
                                    ValueChanged="OnSeekSliderValueChanged"/>

                            <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="3:20" 
                                       Foreground="#A0A0A8" FontSize="11" FontWeight="SemiBold" 
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Playback Control Buttons -->
                        <Grid Grid.Row="1">
                            <!-- Left: Volume Controls + Percentage -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" 
                                        ToolTip="Volume Down" Click="OnVolumeDownClick">
                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Data="M2,5 L5,5 L9,1 L9,13 L5,9 L2,9 Z" Width="11" Height="11" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" 
                                        ToolTip="Volume Up" Click="OnVolumeUpClick" Margin="2,0,0,0">
                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Data="M2,5 L5,5 L9,1 L9,13 L5,9 L2,9 Z M11,4 C12.5,5.5 12.5,8.5 11,10" 
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          StrokeThickness="1.3" Width="12" Height="11" Stretch="Uniform"/>
                                </Button>
                                <TextBlock x:Name="ControlsVolumeText" Text="68%" Foreground="#7A7A84" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- Center: Track Transport Controls (Large & Extra Rounded) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Shuffle Toggle -->
                                <Button x:Name="ShuffleButton" Style="{StaticResource IconButtonStyle}" ToolTip="Shuffle: Off" Click="OnShuffleClick" Margin="0,0,8,0">
                                    <Path x:Name="ShuffleIconPath" Fill="#888888" 
                                          Data="M10.59,9.17 L5.41,4 L4,5.41 L9.17,10.59 L10.59,9.17 Z M14.5,4 L16.54,6.04 L4,18.59 L5.41,20 L17.96,7.46 L20,9.5 V4 H14.5 Z M14.83,13.41 L13.42,14.82 L16.55,17.95 L14.5,20 H20 V14.5 L17.96,16.54 L14.83,13.41 Z" 
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- Previous Track -->
                                <Button Style="{StaticResource RoundControlButtonStyle}" ToolTip="Previous Track" Click="OnPreviousClick">
                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Data="M10,2 L3,7 L10,12 Z M2,2 H3 V12 H2 Z" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- Rewind 10s -->
                                <Button Style="{StaticResource RoundControlButtonStyle}" ToolTip="Rewind 10s" Click="OnRewind10Click" Margin="6,0,0,0">
                                    <TextBlock Text="-10" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </Button>

                                <!-- MASTER PLAY / PAUSE BUTTON (46x46 circular) -->
                                <Button x:Name="PlayPauseButton" Width="46" Height="46" Margin="10,0" Cursor="Hand" Click="OnPlayPauseClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PlayPauseButtonBorder" Width="46" Height="46" CornerRadius="23" Background="#1ED760">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="PlayButtonGlow" BlurRadius="18" ShadowDepth="0" Color="#1ED760" Opacity="0.8"/>
                                                </Border.Effect>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Play Icon -->
                                                    <Path x:Name="PlayIcon" Fill="#0E0E10" Data="M2,1 L13,7.5 L2,14 Z" Width="13" Height="14" Stretch="Uniform" Margin="2,0,0,0"/>
                                                    <!-- Pause Icon -->
                                                    <Path x:Name="PauseIcon" Fill="#0E0E10" Data="M2,1 H5.5 V14 H2 Z M8.5,1 H12 V14 H8.5 Z" Width="12" Height="14" Stretch="Uniform" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PlayPauseButtonBorder" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="PlayPauseButtonBorder" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Fast-Forward 10s -->
                                <Button Style="{StaticResource RoundControlButtonStyle}" ToolTip="Skip Forward 10s" Click="OnFastForward10Click" Margin="0,0,6,0">
                                    <TextBlock Text="+10" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </Button>

                                <!-- Next Track -->
                                <Button Style="{StaticResource RoundControlButtonStyle}" ToolTip="Next Track" Click="OnNextClick">
                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                          Data="M2,2 L9,7 L2,12 Z M9,2 H10 V12 H9 Z" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- Repeat Toggle -->
                                <Button x:Name="RepeatButton" Style="{StaticResource IconButtonStyle}" ToolTip="Repeat: Off" Click="OnRepeatClick" Margin="8,0,0,0">
                                    <Grid>
                                        <Path x:Name="RepeatIconPath" Fill="#888888" 
                                              Data="M7,7 H17 V10 L21,6 L17,2 V5 H5 V11 H7 V7 Z M17,17 H7 V14 L3,18 L7,22 V19 H19 V13 H17 V17 Z" 
                                              Width="13" Height="13" Stretch="Uniform"/>
                                        <TextBlock x:Name="RepeatBadgeText" Text="1" Foreground="#1ED760" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Right: Shortcut Tip -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#15FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,3" ToolTip="Global Hotkeys: Ctrl+Alt+Space (Play/Pause), Ctrl+Alt+Arrows (Next/Prev)">
                                    <TextBlock Text="Ctrl+Alt+Space" Foreground="#777777" FontSize="9.5"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
